{
  "name": "clutch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @clutch/web",
    "dev:api": "npm run dev --workspace @clutch/api",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "tunnel": "ngrok http 5173",
    "build": "npm run typecheck && npm run build --workspace @clutch/web",
    "preflight:production": "node scripts/preflight-production.mjs",
    "preflight:production:write-config": "node scripts/preflight-production.mjs --write-config",
    "test": "vitest run",
    "test:preflight:production": "node scripts/preflight-production.mjs --test-fixture",
    "calibrate:pricing": "node scripts/calibrate-pricing.mjs",
    "test:smoke:local": "node scripts/smoke-local.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "content:check": "vitest run packages/shared/src/generalPack",
    "content:import": "node scripts/content/import.mjs",
    "content:wikidata": "node scripts/content/build-wikidata-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.1",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
