{
  "name": "clutch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @clutch/web",
    "dev:api": "npm run dev --workspace @clutch/api",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "tunnel": "ngrok http 5173",
    "build": "npm run typecheck && npm run build --workspace @clutch/web",
    "preflight:production": "node scripts/preflight-production.mjs",
    "preflight:production:write-config": "node scripts/preflight-production.mjs --write-config",
    "test": "vitest run",
    "test:preflight:production": "node scripts/preflight-production.mjs --test-fixture",
    "calibrate:pricing": "node scripts/calibrate-pricing.mjs",
    "reports": "node scripts/telemetry-view.mjs reports",
    "activity": "node scripts/telemetry-view.mjs activity",
    "player": "node scripts/telemetry-view.mjs player",
    "funnel": "node scripts/telemetry-view.mjs funnel",
    "retention": "node scripts/telemetry-view.mjs retention",
    "errors": "node scripts/telemetry-view.mjs errors",
    "reports:pull": "node scripts/reports-pull.mjs",
    "test:smoke:local": "node scripts/smoke-local.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "content:check": "vitest run packages/shared/src/generalPack",
    "content:import": "node scripts/content/import.mjs",
    "content:wikidata": "node scripts/content/build-wikidata-pack.mjs",
    "tiebreaker:load": "node scripts/tiebreaker-load.mjs",
    "content:day": "vite-node scripts/content/export-day.ts",
    "content:paintings": "node scripts/content/painting-images.mjs",
    "content:review": "node scripts/content/review.mjs",
    "content:approve": "node scripts/content/approve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.1",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
