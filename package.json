{
  "name": "clutch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @clutch/web",
    "dev:api": "npm run dev --workspace @clutch/api",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "tunnel": "ngrok http 5173",
    "build": "npm run typecheck && npm run build --workspace @clutch/web",
    "test": "vitest run",
    "test:smoke:local": "node scripts/smoke-local.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "deploy:web": "npm run deploy --workspace @clutch/web",
    "deploy:api": "npm run deploy --workspace @clutch/api"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
