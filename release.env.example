# Шаблон входов первого prod-выпуска. Скопируйте в release.env (он в .gitignore,
# не коммитить) и заполните. Загрузка в сессию PowerShell — см. docs/RELEASE.md, шаг 2.
# Формат строк: KEY=value, без кавычек и пробелов вокруг "=".
#
# СЕКРЕТЫ СЮДА НЕ ПИШУТ. TELEGRAM_BOT_TOKEN и SESSION_SIGNING_SECRET задаются
# только через `wrangler secret put` (RELEASE.md, шаг 5).

# Имя prod-Worker. Придумываете сами: строчные буквы, цифры, дефисы. Не "clutch-api" (это dev).
# Итоговый URL: https://<имя>.<ваш-поддомен>.workers.dev
CLUTCH_PRODUCTION_WORKER_NAME=

# Имя prod-базы D1: то, что передали в `wrangler d1 create` (по плану clutch-prod).
CLUTCH_PRODUCTION_D1_NAME=

# UUID базы: вывод `wrangler d1 create` (поле database_id) или `wrangler d1 list`.
CLUTCH_PRODUCTION_D1_ID=

# Числовой namespace_id Rate Limiting: выбираете сами, уникален в аккаунте Cloudflare,
# не равен dev-значению из apps/api/wrangler.toml (см. RELEASE.md, шаг 1).
CLUTCH_PRODUCTION_RATE_LIMIT_NAMESPACE_ID=

# Публичный https-URL prod-Worker без пути, например https://clutch-api-prod.<поддомен>.workers.dev.
# Попадает в web-bundle как VITE_API_URL.
CLUTCH_PRODUCTION_API_URL=

# Имя проекта Cloudflare Pages (`wrangler pages project create`).
CLUTCH_PAGES_PROJECT_NAME=

# Ссылка Mini App в формате https://t.me/<bot>?startapp (production-бот — @playclutchbot).
# Идёт в vars Worker как TELEGRAM_MINI_APP_LINK (страница шаринга).
CLUTCH_PRODUCTION_TELEGRAM_MINI_APP_LINK=https://t.me/playclutchbot?startapp

# Ссылка из шаринга: https://t.me/<bot>?startapp (сразу открывает Mini App; можно и https://t.me/<bot>).
# То же имя бота, что выше, иначе preflight откажет. Идёт в web-bundle как VITE_TELEGRAM_BOT_LINK
# (шаринг результата забега и «На глазок»).
CLUTCH_PRODUCTION_TELEGRAM_BOT_LINK=https://t.me/playclutchbot?startapp

# Origin prod-веба (Pages) без пути: https://<проект>.pages.dev или свой домен.
# Идёт в vars Worker как PUBLIC_WEB_ORIGIN (абсолютный URL картинки шаринга).
CLUTCH_PRODUCTION_PUBLIC_WEB_ORIGIN=
