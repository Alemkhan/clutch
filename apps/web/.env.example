# Local development uses same-origin /api through the Vite proxy.
# Set this only when Cloudflare Pages and the Worker use different origins.
VITE_API_URL=https://clutch-api.example.workers.dev

# Ссылка на бота: куда зовёт «Поделиться результатом» в «На глазок». Без неё — адрес самой страницы.
# VITE_TELEGRAM_BOT_LINK=https://t.me/<bot>?startapp
